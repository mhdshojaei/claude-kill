# WireGuard tunnel name (as shown in WireGuard.app / `scutil --nc list`)
WG_TUNNEL_NAME="CHANGE_ME"

# Exit must match this geo (supports comma-separated values, e.g. "TR,AE")
# Country check is dynamic — all cities of that country will be accepted!
REQUIRE_COUNTRIES="TR,AE"
REQUIRE_CITIES=""

# Legacy compatibility
REQUIRE_COUNTRY="TR"
REQUIRE_CITY="Istanbul"

# Optional direct IP / CIDR allow-list (comma-separated, e.g. "1.2.3.4, 5.6.7.0/24")
# If matched, connection is considered safe immediately.
ALLOWED_IPS=""

# Optional ASN allow-list (comma-separated). Empty = skip ASN check.
# Example for Fiba Cloud Istanbul: AS44382
REQUIRE_ASNS=""

# LaunchAgent interval is set in the plist (default 10s)
CHECK_INTERVAL_SECONDS=10

# Quit protected apps when unsafe (1=yes, 0=no)
QUIT_CLAUDE_WHEN_UNSAFE=1
QUIT_BRAVE_WHEN_UNSAFE=1

# macOS notification on state change (1=yes, 0=no)
NOTIFY_ON_CHANGE=1

# Little Snitch integration
# Create a Local Rule Group with this exact name, import little-snitch/*.lsrules
# (includes Claude + Brave), leave the group Disabled, enable Terminal access in
# LS Settings → Security, then set USE_LITTLE_SNITCH=1 after passwordless sudo works.
LS_RULE_GROUP="Claude Kill Switch"
LS_CLI="/Applications/Little Snitch.app/Contents/Components/littlesnitch"
USE_LITTLE_SNITCH=0
